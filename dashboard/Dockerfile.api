FROM python:3.11-slim
WORKDIR /app
COPY api/requirements.txt /app/api/requirements.txt
RUN pip install --no-cache-dir -r /app/api/requirements.txt
COPY api /app/api
COPY data /app/data
COPY literature_review.md /app/literature_review.md
ENV PYTHONPATH=/app/api
EXPOSE 8000
CMD ["uvicorn", "rag_server:app", "--host", "0.0.0.0", "--port", "8000", "--app-dir", "/app/api"]
